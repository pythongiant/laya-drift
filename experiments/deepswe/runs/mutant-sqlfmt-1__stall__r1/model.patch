+            and any(
+                b.is_ddl_statement_start for b in first.previous_node.open_brackets
+            )
+        )
+
+    @property
+    def is_ddl_statement_start_line(self) -> bool:
+        """True if this line contains the ``DDL_STATEMENT_START`` token.
