{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid"
  },
  "include": [".opencode/**/*.ts", ".opencode/**/*.tsx", "scripts/**/*.ts"]
}
